{
  "name": "Bluefield ops-automation-portfolio (demo data only)",
  "image": "mcr.microsoft.com/devcontainers/python:3.3.2-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
  },
  "postCreateCommand": "pipx install uv==0.13.0 && make setup",
  "forwardPorts": [3000, 5678, 8025, 8080],
  "portsAttributes": {
    "3000": { "label": "Metabase", "onAutoForward": "silent" },
    "5678": { "label": "n8n", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit", "onAutoForward": "silent" },
    "8080": { "label": "ERPNext", "onAutoForward": "silent" },
    "5432": { "label": "Postgres (not forwarded)", "onAutoForward": "ignore" },
    "1025": { "label": "Mailpit SMTP (not forwarded)", "onAutoForward": "ignore" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "anthropic.claude-code"]
    }
  }
}
