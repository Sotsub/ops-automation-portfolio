# Copy to .env and fill in your own values. Never commit .env.
# Nothing here is required for lint or unit tests.

APP_ENV=dev
LOG_LEVEL=INFO

# AI settings (used from Project 2 onward). Leave blank until then.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# --- Shared Docker stack (infra/docker-compose.yml) ---------------------------
# Secrets: leave blank and run `make env-secrets`. It fills blank values with
# random ones and never overwrites a value you already set. Use only letters and
# digits if you set them by hand (Docker Compose treats "$" specially).
POSTGRES_PASSWORD=
METABASE_DB_PASSWORD=
N8N_DB_PASSWORD=
# Read-only login that Metabase uses for the marts schema (Project 1).
REPORTING_READER_PASSWORD=
# Metabase admin login that `make dashboards` creates on first run (sign in with these).
METABASE_ADMIN_PASSWORD=
MB_ENCRYPTION_SECRET_KEY=
N8N_ENCRYPTION_KEY=

# Reporting database: admin login and database name.
POSTGRES_USER=bluefield_admin
POSTGRES_DB=bluefield
# Used by local scripts and tests to reach Postgres from outside Docker.
POSTGRES_HOST=localhost

# Host ports. Every service binds to 127.0.0.1 only.
POSTGRES_PORT=5432
METABASE_PORT=3000
# Email for the Metabase admin login. example.com can't receive mail, which suits a demo.
METABASE_ADMIN_EMAIL=admin@example.com
N8N_PORT=5678
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Timezone for n8n schedules, Metabase reports, and Mailpit. Postgres stays in UTC.
STACK_TIMEZONE=America/New_York
# Public URL n8n puts in webhook links. Change it when you use a tunnel.
N8N_WEBHOOK_URL=http://localhost:5678/

# --- ERPNext (official frappe_docker pwd.yml + infra/erpnext/compose.override.yml) ---
# Host port for the ERPNext web UI and API. Bound to 127.0.0.1 only.
ERPNEXT_PORT=8080
# Base URL that scripts and tests use to reach ERPNext. Keep it in step with ERPNEXT_PORT.
ERPNEXT_URL=http://localhost:8080
# Password for the ERPNext "Administrator" login. Leave blank and run `make env-secrets`.
# `make erp-up` applies it right after the site is created, replacing pwd.yml's default "admin".
ERPNEXT_ADMIN_PASSWORD=
# API key for the integration user that scripts use instead of the admin password.
# Leave blank. `make erp-api-keys` creates the user and fills both values.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
